{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {"builder": "DOCKERFILE", "dockerfilePath": "Dockerfile", "watchPatterns": ["/Dockerfile", "/VERSION.json", "/railway.json"]},
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 120,
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 20,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
